{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "AGY Fleet MCP",
    "version": "0.1.0",
    "identifier": "com.sandraschi.agy-fleet-mcp",
    "build": {
        "frontendDist": "../web_sota/dist"},
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "AGY Fleet MCP",
                "width": 1280,
                "height": 860,
                "minWidth": 700,
                "minHeight": 500,
                "resizable": true
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": ["nsis"],
        "icon": ["icons/icon.png", "icons/icon.ico"],
        "resources": [
            "resources/agy-fleet-mcp-backend.exe",
            "resources/.env"],
        "windows": {
            "webviewInstallMode": { "type": "skip" },
            "nsis": {
                "installMode": "currentUser",
                "installerHooks": "./windows/hooks.nsh"
            }
        }
    },
    "plugins": {}
}







